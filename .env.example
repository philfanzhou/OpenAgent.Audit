# OpenAgent.Audit environment template — copy to .env and fill in.
#
# IMPORTANT: docker compose reads this file verbatim. An inline `# comment`
# after a value becomes PART of the value, so every annotation below sits on
# its own line. Keep that style when you edit your .env.
#
# Generate with:  openssl rand -base64 32   (secrets)
#                 openssl rand -hex 32      (ENCRYPTION_KEY, tokens)

# --- Langfuse ---------------------------------------------------------------
LANGFUSE_DB_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
REDIS_PASSWORD=change-me

# REQUIRED: openssl rand -base64 32  (Langfuse session encryption)
NEXTAUTH_SECRET=

# REQUIRED: openssl rand -base64 32  (Langfuse API key salt)
SALT=

# REQUIRED: openssl rand -hex 32  (Langfuse data encryption)
ENCRYPTION_KEY=

# Created in the Langfuse UI after the first start (Project settings -> API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

MINIO_ROOT_USER=openagent
MINIO_ROOT_PASSWORD=change-me

# --- Audit domain -------------------------------------------------------------
# The schema owner's password. Used ONLY by deploy/init_db.sh to create the
# schema and roles — it is never handed to an application service.
# REQUIRED: openssl rand -hex 32
AUDIT_OWNER_PASSWORD=

# One DISTINCT password per service role (openssl rand -hex 32 each).
# They must not repeat: a shared password lets any service attempt to connect
# as another role and defeats the privilege split. deploy/init_db.sh refuses
# to initialise a database where two of them match.
AUDIT_AGENT_WRITER_PASSWORD=
AUDIT_API_PASSWORD=
AUDIT_DECRYPT_PASSWORD=
AUDIT_RETENTION_PASSWORD=

# REQUIRED: shared secret audit-api -> decrypt-svc (openssl rand -hex 32)
AUDIT_SERVICE_TOKEN=

# Platform identities (AUDIT_AUTH_PROVIDER=static). Format: token:username:user
# Every identity here is an ordinary user: they see masked conversations only.
# The administrator role is granted by the admin login below, never by a token.
AUDIT_USERS=token-alice:alice:user,token-bob:bob:user

# --- Administrator account ----------------------------------------------------
# Reached by the "管理员登录" button inside a signed-in console session. Once
# unlocked, masked values become clickable; every reveal is written to the
# append-only audit log before the plaintext is returned.
AUDIT_ADMIN_USERNAME=admin

# Prefer the hash (python scripts/hash_admin_password.py --password '...'):
# a leaked .env then does not hand out decryption capability.
AUDIT_ADMIN_PASSWORD_HASH=

# Plaintext alternative for local runs only. AUDIT_ADMIN_PASSWORD_HASH wins if
# both are set. Leave both empty to disable the administrator login entirely.
# AUDIT_ADMIN_PASSWORD=change-me

# How long an unlock lasts before the session drops back to a normal user.
# The console can decrypt conversations, so the window is short by design.
AUDIT_ADMIN_SESSION_MINUTES=5

# After the unlock ends (by timeout or by 退出管理员) the same account must wait
# this long before it may unlock again. Blocked attempts are logged.
AUDIT_ADMIN_COOLDOWN_MINUTES=10

# --- Local test account (fallback) --------------------------------------------
# A deliberate backstop for when OpenAgent is not forwarding an identity: it
# lets somebody confirm the console renders. It is ALWAYS an ordinary user —
# it cannot log in as administrator — and its session expires after one hour.
# Leave either value empty to disable the test login entirely.
AUDIT_TEST_USERNAME=test
AUDIT_TEST_PASSWORD=test@123456
AUDIT_TEST_SESSION_MINUTES=60

# --- Display timezone ---------------------------------------------------------
# Entries are always STORED in UTC; this zone is used to render them in the
# console and to interpret the date filters an operator types. Rendering raw
# UTC would show a 13:37 Beijing event as 05:37.
AUDIT_DISPLAY_TIMEZONE=Asia/Shanghai

# --- Masking Gateway (OpenAgent .NET platform -> audit) ------------------------
# REQUIRED: bearer token the OpenAgent Engine sends on OTLP ingest:
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <value>"
# docker-compose.yml sets AUDIT_GATEWAY_REQUIRE_AUTH=true, so an empty value
# stops the gateway instead of silently accepting unauthenticated plaintext.
# Must equal OPENAGENT_OTLP_TRACES_HEADERS on the OpenAgent side.
AUDIT_GATEWAY_TOKEN=

# Leave empty to use the gateway defaults (openagent.conversation_id /
# openagent.user_id / openagent.agent_id and the gen_ai.* content prefixes).
AUDIT_GATEWAY_SESSION_ATTRS=
AUDIT_GATEWAY_USER_ATTRS=
AUDIT_GATEWAY_AGENT_ATTRS=
AUDIT_GATEWAY_CONTENT_PREFIXES=

# --- Key custody --------------------------------------------------------------
# "local" (PEM files in ./keys, mounted read-only) or "kms" (AWS KMS).
AUDIT_KEY_PROVIDER=local

# Passphrase used by scripts/provision_keys.py when generating the keypair.
# decrypt-svc needs it; the masking gateway only ever sees the public key.
AUDIT_PRIVATE_KEY_PASSPHRASE=

AUDIT_KMS_KEY_ID=
AUDIT_PUBLIC_KEY_PATH=/keys/audit_public_key.pem

# --- Storage / trace source ---------------------------------------------------
AUDIT_OBJECT_STORE=s3
AUDIT_TRACE_STORE=langfuse

# --- Retention / compliance knobs (confirm with compliance) -------------------
AUDIT_TRACE_RETENTION_DAYS=90
AUDIT_ARCHIVE_AFTER_DAYS=30
AUDIT_REVEAL_TTL_MINUTES=60
AUDIT_PII_BACKEND=rules

# --- Identity source -----------------------------------------------------------
# static = AUDIT_USERS above; http = token introspection endpoint below.
# The platform's introspection endpoint is not implemented yet, so keep "static".
AUDIT_AUTH_PROVIDER=static
AUDIT_AUTH_INTROSPECT_URL=
AUDIT_AUTH_CACHE_SECONDS=60

# --- Outbound TLS (internal CA) --------------------------------------------------
# Every outbound HTTP client (Langfuse, Loki, decrypt-svc, introspection) uses
# this trust policy. Point AUDIT_CA_BUNDLE at the company CA bundle when those
# targets present certificates the container does not already trust;
# REQUESTS_CA_BUNDLE / SSL_CERT_FILE are accepted as fallbacks.
#
# AUDIT_TLS_VERIFY=false disables verification entirely — a last resort that
# logs a warning at startup. Prefer trusting the CA.
AUDIT_CA_BUNDLE=
AUDIT_TLS_VERIFY=true

# --- Docker networks ------------------------------------------------------------
# This stack OWNS both networks and must be started before the OpenAgent stack.
# openagent-audit : this stack + the OpenAgent engine/router (traces to gateway)
# openagent       : this stack + the OpenAgent app (the platform's app network)
OPENAGENT_APP_NETWORK=openagent
AUDIT_COMPOSE_NETWORK=openagent-audit