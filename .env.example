# OpenAgent.Audit environment template — copy to .env and fill in.
# Every value marked REQUIRED must be set before `docker compose up`.

# --- Langfuse ---------------------------------------------------------------
LANGFUSE_DB_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
REDIS_PASSWORD=change-me
NEXTAUTH_SECRET=            # REQUIRED: openssl rand -base64 32
SALT=                       # REQUIRED: openssl rand -base64 32
ENCRYPTION_KEY=             # REQUIRED: openssl rand -hex 32
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
MINIO_ROOT_USER=openagent
MINIO_ROOT_PASSWORD=change-me

# --- Audit domain -------------------------------------------------------------
AUDIT_DB_PASSWORD=change-me
AUDIT_SERVICE_TOKEN=        # REQUIRED: shared secret audit-api -> decrypt-svc
AUDIT_USERS=token-auditor:alice:auditor,token-lead:bob:compliance_lead,token-lead2:carol:compliance_lead,token-dev:dan:developer

# Key custody: local PEM (mounted at ./keys) or kms
AUDIT_KEY_PROVIDER=local
AUDIT_PRIVATE_KEY_PASSPHRASE=
AUDIT_KMS_KEY_ID=
AUDIT_PUBLIC_KEY_PATH=/keys/audit_public_key.pem

AUDIT_OBJECT_STORE=s3
AUDIT_TRACE_STORE=langfuse

# Retention / compliance knobs (proposal §10-11; confirm with compliance)
AUDIT_TRACE_RETENTION_DAYS=90
AUDIT_ARCHIVE_AFTER_DAYS=30
AUDIT_REVEAL_TTL_MINUTES=10
AUDIT_PII_BACKEND=rules
