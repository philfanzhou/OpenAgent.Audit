.env
.env.*
keys
data
.venv
__pycache__
*.pyc
.pytest_cache
.pytest_cache
.ruff_cache
docs
tests
scripts
deployment
frontend/node_modules
frontend/src
frontend/dist/**/*.map
_*.py
.dockerignore
